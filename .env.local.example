# ===== Paloma設備 環境変数 =====
# このファイルをコピーして .env.local を作成してください。

# Neon Postgres（設備専用DB。他のPalomaアプリとはアカウント独立）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# next-auth セッション署名鍵（`openssl rand -base64 32` で生成）
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:5183"

# Vercel Blob（設備写真・取扱説明書・図面PDF・点検写真の保管）
BLOB_READ_WRITE_TOKEN=""

# Resend（点検期限アラート・点検完了の承認依頼メール送信）。未設定ならメール送信はスキップ。
RESEND_API_KEY=""
ALERT_MAIL_FROM="Paloma設備 <noreply@sumakouba.com>"
# 点検完了→承認依頼メールの送信元（未設定なら ALERT_MAIL_FROM→MAIL_FROM を使用）。宛先は設定画面の承認者メール。
APPROVAL_MAIL_FROM="Paloma設備 <noreply@sumakouba.com>"
# 承認依頼メール内のリンク生成に使う本番URL（未設定なら本番ドメインを既定使用）
APP_URL="https://sumakouba-setsubi.vercel.app"

# Vercel Cron からアラート送信API（/api/cron/inspection-alert）を叩く際の認証トークン（任意の長い文字列）
CRON_SECRET="change-me"

# 点検期限が何日前になったらアラートを出すか（カンマ区切り、既定: 30,7,1）
ALERT_LEAD_DAYS="30,7,1"

# Stripe（法人プラン サブスク課金。30日トライアル後にロック）
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STANDARD_MONTHLY=""   # 月額 ¥19,800 の price ID（price_...）
STRIPE_PRICE_STANDARD_YEARLY=""    # 年額 ¥198,000 の price ID（price_...）
APP_URL="https://sumakouba-setsubi.vercel.app"   # Checkout の戻りURL
