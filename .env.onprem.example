# =============================================================================
# スマコウバ設備 オンプレ版 環境設定
#
# 使い方:
#   cp .env.onprem.example .env
#   （docker compose は同じディレクトリの .env を自動で読み込みます）
#
# ※ このファイル(.env)は秘密情報を含みます。Git にコミットしないでください。
# =============================================================================

# --- 必須: 秘密情報（初回に一度だけ生成し、以後は変更しないこと） ---

# PostgreSQL のパスワード。
# DATABASE_URL（接続文字列）に埋め込まれるため、URL に安全な英数字のみを推奨。
# 生成例: openssl rand -hex 32
POSTGRES_PASSWORD=

# next-auth のセッション署名キー。変更すると全員が再ログインになります。
# 生成例: openssl rand -base64 32
NEXTAUTH_SECRET=

# 点検期限アラート API（/api/cron/inspection-alert）の Bearer 認証キー。
# 生成例: openssl rand -base64 32
CRON_SECRET=

# --- 必須: サーバーのアドレス ---

# 社内のブラウザからアクセスする際の固定 IP アドレスまたはホスト名。
# 例: 192.168.1.50 や setsubi.example.local
# ブラウザで開く URL「http://<SERVER_HOST>:8080」と一致させてください
# （不一致だとログインのリダイレクトが正しく動きません）。
# DHCP で IP が変わる環境では固定 IP の割当を推奨します。
SERVER_HOST=

# --- 任意: SMTP（点検期限アラートメールの送信。未設定なら送信をスキップ） ---

# 社内メールサーバーまたはメールプロバイダの SMTP ホスト
SMTP_HOST=
# ポート（587=STARTTLS が一般的。465=SMTPS の場合は SMTP_SECURE=1 に）
SMTP_PORT=587
# 認証ユーザー / パスワード（認証不要のリレーなら空のままで可）
SMTP_USER=
SMTP_PASS=
# 465(SMTPS) 接続なら 1、587(STARTTLS) や平文なら 0
SMTP_SECURE=0
# 差出人（表示名 <メールアドレス> の形式）
MAIL_FROM=設備管理 <setsubi@example.co.jp>
